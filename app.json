{
  "expo": {
    "name": "AnalisMarket",
    "slug": "analismarket-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0C0B09",
    "primaryColor": "#C9A961",
    "scheme": "analismarket",
    "description": "Analisa teknikal otomatis untuk 131 pasar. Alat baca chart, bukan alat prediksi.",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0C0B09"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "id.analismarket.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "id.analismarket.app",
      "adaptiveIcon": {
        "backgroundColor": "#0C0B09",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "edgeToEdgeEnabled": true,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "2bf750c3-f839-4568-9eba-3dc2ae01be33"
      }
    },
    "owner": "polosan",
    "plugins": [
      "expo-secure-store",
      "expo-web-browser"
    ]
  }
}
