{
  /* Skrip Node: tsx yang menjalankannya, bukan Metro. Sengaja TIDAK
     mewarisi preset Expo — lihat alasannya di ../tsconfig.json. */
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ESNext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ESNext", "DOM"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["**/*.mts", "**/*.ts"]
}
