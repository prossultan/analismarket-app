{
  "name": "analismarket-app",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@clerk/clerk-expo": "^2.20.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.19.2",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "expo": "~57.0.23",
    "expo-auth-session": "~57.0.12",
    "expo-blur": "~57.0.3",
    "expo-clipboard": "~57.0.2",
    "expo-crypto": "~57.0.3",
    "expo-device": "~57.0.2",
    "expo-keep-awake": "~57.0.2",
    "expo-linear-gradient": "~57.0.2",
    "expo-notifications": "~57.0.20",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/node": "^22.20.4",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "periksa": "tsc --noEmit && tsc --noEmit -p skrip && node skrip/periksa-teks.mjs && node skrip/periksa-kaca.mjs && node skrip/periksa-lambang.mjs && node skrip/periksa-jawaban.mjs && node skrip/periksa-harga.mjs && node skrip/periksa-kontrol.mjs && node skrip/periksa-satuan.mjs",
    "ukur-laju": "tsx skrip/ukur-laju.mts",
    "uji-e2e": "npx --yes tsx skrip/uji-e2e.mts",
    "periksa-izin": "node skrip/periksa-izin.mjs",
    "periksa-rilis": "npm run periksa && npm run periksa-izin && npm run periksa-bundel && npm run uji-e2e",
    "periksa-bundel": "npx --yes tsx skrip/periksa-bundel.mjs",
    "periksa-apk": "node skrip/periksa-apk.mjs"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "exclude": [
        "@solana-mobile/mobile-wallet-adapter-protocol",
        "@solana-mobile/mobile-wallet-adapter-protocol-web3js",
        "@solana-mobile/wallet-adapter-mobile",
        "@solana-mobile/wallet-standard-mobile"
      ]
    }
  }
}
